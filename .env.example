# Copy to .env (gitignored). Never commit real tokens.

# Fine-grained PAT, Repository access: "Public repositories (read-only)". No extra permissions.
GITHUB_READ_TOKEN=

# Fine-grained PAT, Repository access: only the sandbox repo. Permissions: Issues = Read and write.
GITHUB_WRITE_TOKEN=

# Optional: override the warehouse file (default: warehouse.duckdb in the repo root)
# DUCKDB_PATH=warehouse.duckdb
